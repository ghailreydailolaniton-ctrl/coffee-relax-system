# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_ANON_KEY_HERE

# Optional: Enable sound notifications by default (true/false)
VITE_DEFAULT_SOUND_ENABLED=true

# Optional: Default passwords (can be changed in Admin Panel)
VITE_DEFAULT_CASHIER_PASSWORD=admin
VITE_DEFAULT_ADMIN_PASSWORD=sinta123
